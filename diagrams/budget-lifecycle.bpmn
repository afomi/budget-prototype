  <bpmn:exclusiveGateway id="Gateway_Valid" name="Valid?"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>M02</bpmn:incoming><bpmn:outgoing>M03</bpmn:outgoing><bpmn:outgoing>M05</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_Ready" name="Allow selected&#10;attestation"><bpmn:documentation>{&quot;owner&quot;:&quot;Verification gateway&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:&quot;Continue the relevant T1–T7/TA milestone. This validation step creates no extra transaction.&quot;}</bpmn:documentation><bpmn:incoming>M03</bpmn:incoming><bpmn:outgoing>M04</bpmn:outgoing></bpmn:userTask>
  <bpmn:endEvent id="End_Ready" name="Return to milestone"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>M04</bpmn:incoming></bpmn:endEvent>
  <bpmn:userTask id="Task_Flag" name="Flag exception&#10;Retain source record"><bpmn:documentation>{&quot;owner&quot;:&quot;Monitoring / reviewer&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:&quot;Unauthorized, over-limit, or altered records become application exceptions. Do not propose a budget-state transaction.&quot;}</bpmn:documentation><bpmn:incoming>M05</bpmn:incoming><bpmn:outgoing>M06</bpmn:outgoing></bpmn:userTask>
  <bpmn:endEvent id="End_Flag" name="Needs review"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>M06</bpmn:incoming></bpmn:endEvent>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Budget" targetNamespace="https://github.com/afomi/budget-prototype">
 <bpmn:process id="Process_Lifecycle" isExecutable="false">
  <bpmn:laneSet id="Lanes_Lifecycle"><bpmn:lane id="Lane_Preparation" name="1–3 · Request &amp; PR review"><bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Formulate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_OpenPR</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Settled</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Revise</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Propose</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Execution" name="4–8 · Authority &amp; execution"><bpmn:flowNodeRef>Task_Congress</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Enacted</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NoAuthority</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Authority</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Apportion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Allot</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Obligate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PartialReceipt</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Adjustment</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Later" name="Adjustment · Payment · Closeout"><bpmn:flowNodeRef>Task_ReviewAdjustment</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AdjustApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReviseAdjustment</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Adjust</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Continue</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FinalAccept</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FinalPay</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FinalReceipt</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Reconcile</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Checkpoint</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Checkpoint</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
  <bpmn:startEvent id="Start_Request" name="Need identified"><bpmn:documentation>{}</bpmn:documentation><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
  <bpmn:userTask id="Task_Formulate" name="1 · Formulate request&#10;JSON + justification"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency analyst&quot;,&quot;artifact&quot;:&quot;budget-request/&quot;,&quot;notes&quot;:&quot;Prepare the request and supporting narrative before the budget year. No blockchain transaction.&quot;}</bpmn:documentation><bpmn:incoming>F01</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_OpenPR" name="Open budget PR"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency budget office&quot;,&quot;artifact&quot;:&quot;budgets/fy2027-28/bridge-request.json&quot;,&quot;notes&quot;:&quot;Git supplies the document history and line-item diff. No transaction.&quot;}</bpmn:documentation><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Review" name="2 · Passback review&#10;Line-item comments"><bpmn:documentation>{&quot;owner&quot;:&quot;OMB reviewer&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/02-passback.md&quot;,&quot;notes&quot;:&quot;Structured review summary and comments, with an agency response. No transaction.&quot;}</bpmn:documentation><bpmn:incoming>F03</bpmn:incoming><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Settled" name="Ready to settle?"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing><bpmn:outgoing>F06</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_Revise" name="Revise or appeal&#10;Commit response"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency budget office&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/02-request-v1.json&quot;,&quot;notes&quot;:&quot;Revise the same PR or attach an appeal; review again before settlement. No transaction.&quot;}</bpmn:documentation><bpmn:incoming>F06</bpmn:incoming><bpmn:outgoing>F07</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Merge" name="Approve + merge&#10;Document settled"><bpmn:documentation>{&quot;owner&quot;:&quot;Authorized document reviewer&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/02-passback.md&quot;,&quot;notes&quot;:&quot;Merge approves this planning document version; it does not enact an appropriation.&quot;}</bpmn:documentation><bpmn:incoming>F05</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Propose" name="3 · Propose budget&#10;Transmit to Congress"><bpmn:documentation>{&quot;owner&quot;:&quot;Executive&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/03-presidents-budget.md&quot;,&quot;notes&quot;:&quot;Publish the proposal; it does not establish spending authority. No transaction.&quot;}</bpmn:documentation><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Congress" name="4 · Consider / enact&#10;appropriation"><bpmn:documentation>{&quot;owner&quot;:&quot;Congress&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/04-appropriation.md&quot;,&quot;notes&quot;:&quot;Official legislation is the source of authority, independent of the experimental chain.&quot;}</bpmn:documentation><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Enacted" name="Authority enacted?"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:endEvent id="End_NoAuthority" name="No execution authority"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent>
  <bpmn:userTask id="Task_Authority" name="T1 · Record approved&#10;$10M program"><bpmn:documentation>{&quot;owner&quot;:&quot;Budget authority&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T1&quot;,&quot;element&quot;:&quot;Task_Authority&quot;,&quot;name&quot;:&quot;Record approved program&quot;,&quot;owner&quot;:&quot;Budget authority&quot;,&quot;input&quot;:330000,&quot;outputs&quot;:[10000,320000],&quot;split&quot;:&quot;330,000 → 10,000 bridge program + 320,000 other city budget&quot;,&quot;notes&quot;:&quot;Record the independently enacted authority and its source. The federal example is scaled inside the city experiment.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/04-appropriation.md&quot;}}</bpmn:documentation><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Apportion" name="5 · Apportion&#10;T2 · $2.5M"><bpmn:documentation>{&quot;owner&quot;:&quot;OMB&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T2&quot;,&quot;element&quot;:&quot;Task_Apportion&quot;,&quot;name&quot;:&quot;Apportion current-period authority&quot;,&quot;owner&quot;:&quot;OMB / mapped city role&quot;,&quot;input&quot;:10000,&quot;outputs&quot;:[2500,7500],&quot;split&quot;:&quot;10,000 → 2,500 apportioned + 7,500 unapportioned&quot;,&quot;notes&quot;:&quot;The period limit refers to the original authority and its conditions.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/05-apportionment.md&quot;}}</bpmn:documentation><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Allot" name="6 · Allot to district&#10;T3 · $1M"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency funds control&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T3&quot;,&quot;element&quot;:&quot;Task_Allot&quot;,&quot;name&quot;:&quot;Allot to the district&quot;,&quot;owner&quot;:&quot;Agency funds control&quot;,&quot;input&quot;:2500,&quot;outputs&quot;:[1000,1500],&quot;split&quot;:&quot;2,500 → 1,000 district + 1,500 unallotted&quot;,&quot;notes&quot;:&quot;Check purpose, amount, and approvals before recording the allotment.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/06-allotment.md&quot;}}</bpmn:documentation><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Obligate" name="7 · Award / obligate&#10;T4 · $750K"><bpmn:documentation>{&quot;owner&quot;:&quot;Contracting approval&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T4&quot;,&quot;element&quot;:&quot;Task_Obligate&quot;,&quot;name&quot;:&quot;Record contract obligation&quot;,&quot;owner&quot;:&quot;Contracting approval&quot;,&quot;input&quot;:1000,&quot;outputs&quot;:[750,250],&quot;split&quot;:&quot;1,000 → 750 obligated + 250 district/unobligated&quot;,&quot;notes&quot;:&quot;The contract remains in its authoritative system; evidence links the obligation to the allotment.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/07-obligation.md&quot;}}</bpmn:documentation><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Accept" name="Accept work&#10;Approve invoice"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency engineer&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/08-payment.md&quot;,&quot;notes&quot;:&quot;Accept actual work before approving the invoice. No blockchain transaction.&quot;}</bpmn:documentation><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Pay" name="8 · Pay $500K&#10;Financial system"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency finance / Treasury&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/08-payment.md&quot;,&quot;notes&quot;:&quot;Actual payment happens in the financial system. The next task attests its record.&quot;}</bpmn:documentation><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_PartialReceipt" name="T5 · Attest partial&#10;payment · $500K"><bpmn:documentation>{&quot;owner&quot;:&quot;Payment attestation&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T5&quot;,&quot;element&quot;:&quot;Task_PartialReceipt&quot;,&quot;name&quot;:&quot;Attest partial payment&quot;,&quot;owner&quot;:&quot;Payment attestation&quot;,&quot;input&quot;:750,&quot;outputs&quot;:[500,250],&quot;split&quot;:&quot;750 → 500 paid + 250 obligated/unpaid&quot;,&quot;notes&quot;:&quot;Attest the financial-system payment after work acceptance and reconciliation. Marker sats remain in demo custody.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/08-payment.md&quot;}}</bpmn:documentation><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Adjustment" name="Adjustment needed?"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing><bpmn:outgoing>F21</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_ReviewAdjustment" name="Review proposed&#10;adjustment"><bpmn:documentation>{&quot;owner&quot;:&quot;Apportionment reviewer&quot;,&quot;artifact&quot;:&quot;_data/execution_example.json&quot;,&quot;notes&quot;:&quot;Optional review; the existing descendants must remain funded. Review itself needs no transaction.&quot;}</bpmn:documentation><bpmn:incoming>F20</bpmn:incoming><bpmn:incoming>F34</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_AdjustApproved" name="Approved?"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing><bpmn:outgoing>F24</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_ReviseAdjustment" name="Revise / hold&#10;adjustment"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency / reviewer&quot;,&quot;artifact&quot;:&quot;_data/execution_example.json&quot;,&quot;notes&quot;:&quot;Do not change approved authority. Resolve or revise the proposal before another review.&quot;}</bpmn:documentation><bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F34</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Adjust" name="TA · Approved&#10;reapportionment"><bpmn:documentation>{&quot;owner&quot;:&quot;Apportionment reviewer&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;TA&quot;,&quot;element&quot;:&quot;Task_Adjust&quot;,&quot;name&quot;:&quot;Record approved adjustment&quot;,&quot;optional&quot;:true,&quot;owner&quot;:&quot;Apportionment reviewer&quot;,&quot;input&quot;:9000,&quot;outputs&quot;:[7000,2000],&quot;split&quot;:&quot;7,500 unapportioned + 1,500 unallotted → 7,000 + 2,000&quot;,&quot;notes&quot;:&quot;Consume current unspent remainders. The period ceiling increases from 2,500 to 3,000; descendants remain intact.&quot;,&quot;artifact&quot;:&quot;_data/execution_example.json&quot;}}</bpmn:documentation><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F25</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Continue" name="Continue"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>F21</bpmn:incoming><bpmn:incoming>F25</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_FinalAccept" name="Accept remaining&#10;contract work"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency engineer&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;,&quot;notes&quot;:&quot;Later work acceptance, after the current live snapshot.&quot;}</bpmn:documentation><bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_FinalPay" name="Pay final $250K&#10;Financial system"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency finance / Treasury&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;,&quot;notes&quot;:&quot;Actual final payment stays in the financial system.&quot;}</bpmn:documentation><bpmn:incoming>F27</bpmn:incoming><bpmn:outgoing>F28</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_FinalReceipt" name="T6 · Attest final&#10;payment · $250K"><bpmn:documentation>{&quot;owner&quot;:&quot;Payment attestation&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T6&quot;,&quot;element&quot;:&quot;Task_FinalReceipt&quot;,&quot;name&quot;:&quot;Attest later final payment&quot;,&quot;owner&quot;:&quot;Payment attestation&quot;,&quot;input&quot;:250,&quot;outputs&quot;:[250],&quot;split&quot;:&quot;250 obligated/unpaid → 250 paid&quot;,&quot;notes&quot;:&quot;This is a later event, beyond the live dashboard snapshot. The final payment occurs in the financial system.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;}}</bpmn:documentation><bpmn:incoming>F28</bpmn:incoming><bpmn:outgoing>F29</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Reconcile" name="9 · Reconcile&#10;Retain audit trail"><bpmn:documentation>{&quot;owner&quot;:&quot;Finance / audit&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;,&quot;notes&quot;:&quot;Reconcile the $750K contract. Account closeout follows its own availability rules.&quot;}</bpmn:documentation><bpmn:incoming>F29</bpmn:incoming><bpmn:outgoing>F30</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Checkpoint" name="Checkpoint?"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>F30</bpmn:incoming><bpmn:outgoing>F31</bpmn:outgoing><bpmn:outgoing>F33</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_Checkpoint" name="T7 · Optional&#10;reconciliation receipt"><bpmn:documentation>{&quot;owner&quot;:&quot;Reconciliation approval&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T7&quot;,&quot;element&quot;:&quot;Task_Checkpoint&quot;,&quot;name&quot;:&quot;Reconciliation checkpoint&quot;,&quot;optional&quot;:true,&quot;owner&quot;:&quot;Reconciliation approval&quot;,&quot;input&quot;:750,&quot;outputs&quot;:[750],&quot;split&quot;:&quot;500 paid + 250 paid → 750 reconciled&quot;,&quot;notes&quot;:&quot;Optional checkpoint. Paid markers stay historical; reconciliation does not release fresh budget authority.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;}}</bpmn:documentation><bpmn:incoming>F31</bpmn:incoming><bpmn:outgoing>F32</bpmn:outgoing></bpmn:userTask>
  <bpmn:endEvent id="End_Closed" name="Project reconciled"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>F32</bpmn:incoming><bpmn:incoming>F33</bpmn:incoming></bpmn:endEvent>
  <bpmn:sequenceFlow id="F01" sourceRef="Start_Request" targetRef="Task_Formulate"/>
  <bpmn:sequenceFlow id="F02" sourceRef="Task_Formulate" targetRef="Task_OpenPR"/>
  <bpmn:sequenceFlow id="F03" sourceRef="Task_OpenPR" targetRef="Task_Review"/>
  <bpmn:sequenceFlow id="F04" sourceRef="Task_Review" targetRef="Gateway_Settled"/>
  <bpmn:sequenceFlow id="F05" sourceRef="Gateway_Settled" targetRef="Task_Merge" name="Yes"/>
  <bpmn:sequenceFlow id="F06" sourceRef="Gateway_Settled" targetRef="Task_Revise" name="Revise / appeal"/>
  <bpmn:sequenceFlow id="F07" sourceRef="Task_Revise" targetRef="Task_Review"/>
  <bpmn:sequenceFlow id="F08" sourceRef="Task_Merge" targetRef="Task_Propose"/>
  <bpmn:sequenceFlow id="F09" sourceRef="Task_Propose" targetRef="Task_Congress"/>
  <bpmn:sequenceFlow id="F10" sourceRef="Task_Congress" targetRef="Gateway_Enacted"/>
  <bpmn:sequenceFlow id="F11" sourceRef="Gateway_Enacted" targetRef="Task_Authority" name="Yes"/>
  <bpmn:sequenceFlow id="F12" sourceRef="Gateway_Enacted" targetRef="End_NoAuthority" name="No"/>
  <bpmn:sequenceFlow id="F13" sourceRef="Task_Authority" targetRef="Task_Apportion"/>
  <bpmn:sequenceFlow id="F14" sourceRef="Task_Apportion" targetRef="Task_Allot"/>
  <bpmn:sequenceFlow id="F15" sourceRef="Task_Allot" targetRef="Task_Obligate"/>
  <bpmn:sequenceFlow id="F16" sourceRef="Task_Obligate" targetRef="Task_Accept"/>
  <bpmn:sequenceFlow id="F17" sourceRef="Task_Accept" targetRef="Task_Pay"/>
  <bpmn:sequenceFlow id="F18" sourceRef="Task_Pay" targetRef="Task_PartialReceipt"/>
  <bpmn:sequenceFlow id="F19" sourceRef="Task_PartialReceipt" targetRef="Gateway_Adjustment"/>
  <bpmn:sequenceFlow id="F20" sourceRef="Gateway_Adjustment" targetRef="Task_ReviewAdjustment" name="Yes"/>
  <bpmn:sequenceFlow id="F21" sourceRef="Gateway_Adjustment" targetRef="Gateway_Continue" name="No"/>
  <bpmn:sequenceFlow id="F22" sourceRef="Task_ReviewAdjustment" targetRef="Gateway_AdjustApproved"/>
  <bpmn:sequenceFlow id="F23" sourceRef="Gateway_AdjustApproved" targetRef="Task_Adjust" name="Yes"/>
  <bpmn:sequenceFlow id="F24" sourceRef="Gateway_AdjustApproved" targetRef="Task_ReviseAdjustment" name="No"/>
  <bpmn:sequenceFlow id="F34" sourceRef="Task_ReviseAdjustment" targetRef="Task_ReviewAdjustment"/>
  <bpmn:sequenceFlow id="F25" sourceRef="Task_Adjust" targetRef="Gateway_Continue"/>
  <bpmn:sequenceFlow id="F26" sourceRef="Gateway_Continue" targetRef="Task_FinalAccept"/>
  <bpmn:sequenceFlow id="F27" sourceRef="Task_FinalAccept" targetRef="Task_FinalPay"/>
  <bpmn:sequenceFlow id="F28" sourceRef="Task_FinalPay" targetRef="Task_FinalReceipt"/>
  <bpmn:sequenceFlow id="F29" sourceRef="Task_FinalReceipt" targetRef="Task_Reconcile"/>
  <bpmn:sequenceFlow id="F30" sourceRef="Task_Reconcile" targetRef="Gateway_Checkpoint"/>
  <bpmn:sequenceFlow id="F31" sourceRef="Gateway_Checkpoint" targetRef="Task_Checkpoint" name="Yes"/>
  <bpmn:sequenceFlow id="F32" sourceRef="Task_Checkpoint" targetRef="End_Closed"/>
  <bpmn:sequenceFlow id="F33" sourceRef="Gateway_Checkpoint" targetRef="End_Closed" name="No"/>
 </bpmn:process>
 <bpmn:process id="Process_Monitoring" isExecutable="false">
  <bpmn:startEvent id="Start_Record" name="Selected source event"><bpmn:documentation>{}</bpmn:documentation><bpmn:outgoing>M01</bpmn:outgoing></bpmn:startEvent>
  <bpmn:userTask id="Task_Check" name="Check source, approval,&#10;limits and digest"><bpmn:documentation>{&quot;owner&quot;:&quot;Verification gateway&quot;,&quot;artifact&quot;:&quot;flow-model.js&quot;,&quot;notes&quot;:&quot;Application checks run before proposing each selected transaction. This companion flow summarizes those repeated checks.&quot;}</bpmn:documentation><bpmn:incoming>M01</bpmn:incoming><bpmn:outgoing>M02</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Valid" name="Valid?"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>M02</bpmn:incoming><bpmn:outgoing>M03</bpmn:outgoing><bpmn:outgoing>M05</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_Ready" name="Allow selected&#10;attestation"><bpmn:documentation>{&quot;owner&quot;:&quot;Verification gateway&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:&quot;Continue the relevant T1–T7/TA milestone. This validation step creates no extra transaction.&quot;}</bpmn:documentation><bpmn:incoming>M03</bpmn:incoming><bpmn:outgoing>M04</bpmn:outgoing></bpmn:userTask>
  <bpmn:endEvent id="End_Ready" name="Return to milestone"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>M04</bpmn:incoming></bpmn:endEvent>
  <bpmn:userTask id="Task_Flag" name="Flag exception&#10;Retain source record"><bpmn:documentation>{&quot;owner&quot;:&quot;Monitoring / reviewer&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:&quot;Unauthorized, over-limit, or altered records become application exceptions. Do not propose a budget-state transaction.&quot;}</bpmn:documentation><bpmn:incoming>M05</bpmn:incoming><bpmn:outgoing>M06</bpmn:outgoing></bpmn:userTask>
  <bpmn:endEvent id="End_Flag" name="Needs review"><bpmn:documentation>{}</bpmn:documentation><bpmn:incoming>M06</bpmn:incoming></bpmn:endEvent>

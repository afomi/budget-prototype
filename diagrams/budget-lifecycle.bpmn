<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" id="Definitions_Budget" targetNamespace="https://github.com/afomi/budget-prototype">
 <bpmn:process id="Process_Lifecycle" isExecutable="false">
  <bpmn:laneSet id="Lanes_Lifecycle"><bpmn:lane id="Lane_BudgetOffice" name="Agency budget office"><bpmn:flowNodeRef>Start_Request</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Formulate</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_OpenPR</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Revise</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReviseAdjustment</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_OMB" name="OMB budget reviewer"><bpmn:flowNodeRef>Task_Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Settled</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Merge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Apportion</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReviewAdjustment</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_AdjustApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Adjust</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Executive" name="Executive"><bpmn:flowNodeRef>Task_Propose</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Congress" name="Congress"><bpmn:flowNodeRef>Task_Congress</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Enacted</bpmn:flowNodeRef><bpmn:flowNodeRef>End_NoAuthority</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_FundsControl" name="Agency funds control"><bpmn:flowNodeRef>Task_Authority</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Allot</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Adjustment</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Continue</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Contracting" name="Contracting officer"><bpmn:flowNodeRef>Task_Obligate</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Engineer" name="Agency engineer"><bpmn:flowNodeRef>Task_Accept</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FinalAccept</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Finance" name="Agency finance / Treasury"><bpmn:flowNodeRef>Task_Pay</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_PartialReceipt</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FinalPay</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_FinalReceipt</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Audit" name="Finance / audit"><bpmn:flowNodeRef>Task_Reconcile</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Checkpoint</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Checkpoint</bpmn:flowNodeRef><bpmn:flowNodeRef>End_Closed</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
  <bpmn:startEvent id="Start_Request" name="Need identified"><bpmn:documentation>{&quot;actor&quot;:&quot;Agency budget office&quot;,&quot;phase&quot;:&quot;Request and PR review&quot;}</bpmn:documentation><bpmn:outgoing>F01</bpmn:outgoing></bpmn:startEvent>
  <bpmn:userTask id="Task_Formulate" name="Agency budget office&#10;1 · Formulate request&#10;JSON + justification"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency analyst&quot;,&quot;artifact&quot;:&quot;budget-request/&quot;,&quot;notes&quot;:&quot;Prepare the request and supporting narrative before the budget year. No blockchain transaction.&quot;,&quot;actor&quot;:&quot;Agency budget office&quot;,&quot;phase&quot;:&quot;Request and PR review&quot;,&quot;activity&quot;:&quot;1 · Formulate request\nJSON + justification&quot;}</bpmn:documentation><bpmn:incoming>F01</bpmn:incoming><bpmn:outgoing>F02</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_OpenPR" name="Agency budget office&#10;Open budget PR"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency budget office&quot;,&quot;artifact&quot;:&quot;budgets/fy2027-28/bridge-request.json&quot;,&quot;notes&quot;:&quot;Git supplies the document history and line-item diff. No transaction.&quot;,&quot;actor&quot;:&quot;Agency budget office&quot;,&quot;phase&quot;:&quot;Request and PR review&quot;,&quot;activity&quot;:&quot;Open budget PR&quot;,&quot;system&quot;:&quot;GitHub&quot;}</bpmn:documentation><bpmn:incoming>F02</bpmn:incoming><bpmn:outgoing>F03</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Review" name="OMB budget reviewer&#10;2 · Passback review&#10;Line-item comments"><bpmn:documentation>{&quot;owner&quot;:&quot;OMB reviewer&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/02-passback.md&quot;,&quot;notes&quot;:&quot;Structured review summary and comments, with an agency response. No transaction.&quot;,&quot;actor&quot;:&quot;OMB budget reviewer&quot;,&quot;phase&quot;:&quot;Request and PR review&quot;,&quot;activity&quot;:&quot;2 · Passback review\nLine-item comments&quot;,&quot;system&quot;:&quot;GitHub&quot;}</bpmn:documentation><bpmn:incoming>F03</bpmn:incoming><bpmn:incoming>F07</bpmn:incoming><bpmn:outgoing>F04</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Settled" name="Ready to settle?"><bpmn:documentation>{&quot;actor&quot;:&quot;OMB budget reviewer&quot;,&quot;phase&quot;:&quot;Request and PR review&quot;}</bpmn:documentation><bpmn:incoming>F04</bpmn:incoming><bpmn:outgoing>F05</bpmn:outgoing><bpmn:outgoing>F06</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_Revise" name="Agency budget office&#10;Revise or appeal&#10;Commit response"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency budget office&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/02-request-v1.json&quot;,&quot;notes&quot;:&quot;Revise the same PR or attach an appeal; review again before settlement. No transaction.&quot;,&quot;actor&quot;:&quot;Agency budget office&quot;,&quot;phase&quot;:&quot;Request and PR review&quot;,&quot;activity&quot;:&quot;Revise or appeal\nCommit response&quot;,&quot;system&quot;:&quot;GitHub&quot;}</bpmn:documentation><bpmn:incoming>F06</bpmn:incoming><bpmn:outgoing>F07</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Merge" name="OMB budget reviewer&#10;Approve + merge&#10;Document settled"><bpmn:documentation>{&quot;owner&quot;:&quot;Authorized document reviewer&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/02-passback.md&quot;,&quot;notes&quot;:&quot;Merge approves this planning document version; it does not enact an appropriation.&quot;,&quot;actor&quot;:&quot;OMB budget reviewer&quot;,&quot;phase&quot;:&quot;Request and PR review&quot;,&quot;activity&quot;:&quot;Approve + merge\nDocument settled&quot;,&quot;system&quot;:&quot;GitHub&quot;}</bpmn:documentation><bpmn:incoming>F05</bpmn:incoming><bpmn:outgoing>F08</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Propose" name="Executive&#10;3 · Propose budget&#10;Transmit to Congress"><bpmn:documentation>{&quot;owner&quot;:&quot;Executive&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/03-presidents-budget.md&quot;,&quot;notes&quot;:&quot;Publish the proposal; it does not establish spending authority. No transaction.&quot;,&quot;actor&quot;:&quot;Executive&quot;,&quot;phase&quot;:&quot;Request and PR review&quot;,&quot;activity&quot;:&quot;3 · Propose budget\nTransmit to Congress&quot;}</bpmn:documentation><bpmn:incoming>F08</bpmn:incoming><bpmn:outgoing>F09</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Congress" name="Congress&#10;4 · Consider / enact&#10;appropriation"><bpmn:documentation>{&quot;owner&quot;:&quot;Congress&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/04-appropriation.md&quot;,&quot;notes&quot;:&quot;Official legislation is the source of authority, independent of the experimental chain.&quot;,&quot;actor&quot;:&quot;Congress&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;,&quot;activity&quot;:&quot;4 · Consider / enact\nappropriation&quot;}</bpmn:documentation><bpmn:incoming>F09</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Enacted" name="Authority enacted?"><bpmn:documentation>{&quot;actor&quot;:&quot;Congress&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;}</bpmn:documentation><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing><bpmn:outgoing>F12</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:endEvent id="End_NoAuthority" name="No execution authority"><bpmn:documentation>{&quot;actor&quot;:&quot;Congress&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;}</bpmn:documentation><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent>
  <bpmn:userTask id="Task_Authority" name="Agency funds control&#10;T1 · Record approved&#10;$10M program"><bpmn:documentation>{&quot;owner&quot;:&quot;Budget authority&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T1&quot;,&quot;element&quot;:&quot;Task_Authority&quot;,&quot;name&quot;:&quot;Record approved program&quot;,&quot;owner&quot;:&quot;Budget authority&quot;,&quot;input&quot;:330000,&quot;outputs&quot;:[10000,320000],&quot;split&quot;:&quot;330,000 → 10,000 bridge program + 320,000 other city budget&quot;,&quot;notes&quot;:&quot;Record the independently enacted authority and its source. The federal example is scaled inside the city experiment.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/04-appropriation.md&quot;},&quot;actor&quot;:&quot;Agency funds control&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;,&quot;activity&quot;:&quot;T1 · Record approved\n$10M program&quot;}</bpmn:documentation><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F13</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Apportion" name="OMB budget reviewer&#10;5 · Apportion&#10;T2 · $2.5M"><bpmn:documentation>{&quot;owner&quot;:&quot;OMB&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T2&quot;,&quot;element&quot;:&quot;Task_Apportion&quot;,&quot;name&quot;:&quot;Apportion current-period authority&quot;,&quot;owner&quot;:&quot;OMB / mapped city role&quot;,&quot;input&quot;:10000,&quot;outputs&quot;:[2500,7500],&quot;split&quot;:&quot;10,000 → 2,500 apportioned + 7,500 unapportioned&quot;,&quot;notes&quot;:&quot;The period limit refers to the original authority and its conditions.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/05-apportionment.md&quot;},&quot;actor&quot;:&quot;OMB budget reviewer&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;,&quot;activity&quot;:&quot;5 · Apportion\nT2 · $2.5M&quot;}</bpmn:documentation><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Allot" name="Agency funds control&#10;6 · Allot to district&#10;T3 · $1M"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency funds control&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T3&quot;,&quot;element&quot;:&quot;Task_Allot&quot;,&quot;name&quot;:&quot;Allot to the district&quot;,&quot;owner&quot;:&quot;Agency funds control&quot;,&quot;input&quot;:2500,&quot;outputs&quot;:[1000,1500],&quot;split&quot;:&quot;2,500 → 1,000 district + 1,500 unallotted&quot;,&quot;notes&quot;:&quot;Check purpose, amount, and approvals before recording the allotment.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/06-allotment.md&quot;},&quot;actor&quot;:&quot;Agency funds control&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;,&quot;activity&quot;:&quot;6 · Allot to district\nT3 · $1M&quot;}</bpmn:documentation><bpmn:incoming>F14</bpmn:incoming><bpmn:outgoing>F15</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Obligate" name="Contracting officer&#10;7 · Award / obligate&#10;T4 · $750K"><bpmn:documentation>{&quot;owner&quot;:&quot;Contracting approval&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T4&quot;,&quot;element&quot;:&quot;Task_Obligate&quot;,&quot;name&quot;:&quot;Record contract obligation&quot;,&quot;owner&quot;:&quot;Contracting approval&quot;,&quot;input&quot;:1000,&quot;outputs&quot;:[750,250],&quot;split&quot;:&quot;1,000 → 750 obligated + 250 district/unobligated&quot;,&quot;notes&quot;:&quot;The contract remains in its authoritative system; evidence links the obligation to the allotment.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/07-obligation.md&quot;},&quot;actor&quot;:&quot;Contracting officer&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;,&quot;activity&quot;:&quot;7 · Award / obligate\nT4 · $750K&quot;}</bpmn:documentation><bpmn:incoming>F15</bpmn:incoming><bpmn:outgoing>F16</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Accept" name="Agency engineer&#10;Accept work&#10;Approve invoice"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency engineer&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/08-payment.md&quot;,&quot;notes&quot;:&quot;Accept actual work before approving the invoice. No blockchain transaction.&quot;,&quot;actor&quot;:&quot;Agency engineer&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;,&quot;activity&quot;:&quot;Accept work\nApprove invoice&quot;}</bpmn:documentation><bpmn:incoming>F16</bpmn:incoming><bpmn:outgoing>F17</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Pay" name="Agency finance / Treasury&#10;8 · Pay $500K&#10;Financial system"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency finance / Treasury&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/08-payment.md&quot;,&quot;notes&quot;:&quot;Actual payment happens in the financial system. The next task attests its record.&quot;,&quot;actor&quot;:&quot;Agency finance / Treasury&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;,&quot;activity&quot;:&quot;8 · Pay $500K\nFinancial system&quot;}</bpmn:documentation><bpmn:incoming>F17</bpmn:incoming><bpmn:outgoing>F18</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_PartialReceipt" name="Agency finance / Treasury&#10;T5 · Attest partial&#10;payment · $500K"><bpmn:documentation>{&quot;owner&quot;:&quot;Payment attestation&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T5&quot;,&quot;element&quot;:&quot;Task_PartialReceipt&quot;,&quot;name&quot;:&quot;Attest partial payment&quot;,&quot;owner&quot;:&quot;Payment attestation&quot;,&quot;input&quot;:750,&quot;outputs&quot;:[500,250],&quot;split&quot;:&quot;750 → 500 paid + 250 obligated/unpaid&quot;,&quot;notes&quot;:&quot;Attest the financial-system payment after work acceptance and reconciliation. Marker sats remain in demo custody.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/08-payment.md&quot;},&quot;actor&quot;:&quot;Agency finance / Treasury&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;,&quot;activity&quot;:&quot;T5 · Attest partial\npayment · $500K&quot;}</bpmn:documentation><bpmn:incoming>F18</bpmn:incoming><bpmn:outgoing>F19</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Adjustment" name="Adjustment needed?"><bpmn:documentation>{&quot;actor&quot;:&quot;Agency funds control&quot;,&quot;phase&quot;:&quot;Authority and execution&quot;}</bpmn:documentation><bpmn:incoming>F19</bpmn:incoming><bpmn:outgoing>F20</bpmn:outgoing><bpmn:outgoing>F21</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_ReviewAdjustment" name="OMB budget reviewer&#10;Review proposed&#10;adjustment"><bpmn:documentation>{&quot;owner&quot;:&quot;Apportionment reviewer&quot;,&quot;artifact&quot;:&quot;_data/execution_example.json&quot;,&quot;notes&quot;:&quot;Optional review; the existing descendants must remain funded. Review itself needs no transaction.&quot;,&quot;actor&quot;:&quot;OMB budget reviewer&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;,&quot;activity&quot;:&quot;Review proposed\nadjustment&quot;}</bpmn:documentation><bpmn:incoming>F20</bpmn:incoming><bpmn:incoming>F34</bpmn:incoming><bpmn:outgoing>F22</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_AdjustApproved" name="Approved?"><bpmn:documentation>{&quot;actor&quot;:&quot;OMB budget reviewer&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;}</bpmn:documentation><bpmn:incoming>F22</bpmn:incoming><bpmn:outgoing>F23</bpmn:outgoing><bpmn:outgoing>F24</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_ReviseAdjustment" name="Agency budget office&#10;Revise / hold&#10;adjustment"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency / reviewer&quot;,&quot;artifact&quot;:&quot;_data/execution_example.json&quot;,&quot;notes&quot;:&quot;Do not change approved authority. Resolve or revise the proposal before another review.&quot;,&quot;actor&quot;:&quot;Agency budget office&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;,&quot;activity&quot;:&quot;Revise / hold\nadjustment&quot;}</bpmn:documentation><bpmn:incoming>F24</bpmn:incoming><bpmn:outgoing>F34</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Adjust" name="OMB budget reviewer&#10;TA · Approved&#10;reapportionment"><bpmn:documentation>{&quot;owner&quot;:&quot;Apportionment reviewer&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;TA&quot;,&quot;element&quot;:&quot;Task_Adjust&quot;,&quot;name&quot;:&quot;Record approved adjustment&quot;,&quot;optional&quot;:true,&quot;owner&quot;:&quot;Apportionment reviewer&quot;,&quot;input&quot;:9000,&quot;outputs&quot;:[7000,2000],&quot;split&quot;:&quot;7,500 unapportioned + 1,500 unallotted → 7,000 + 2,000&quot;,&quot;notes&quot;:&quot;Consume current unspent remainders. The period ceiling increases from 2,500 to 3,000; descendants remain intact.&quot;,&quot;artifact&quot;:&quot;_data/execution_example.json&quot;},&quot;actor&quot;:&quot;OMB budget reviewer&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;,&quot;activity&quot;:&quot;TA · Approved\nreapportionment&quot;}</bpmn:documentation><bpmn:incoming>F23</bpmn:incoming><bpmn:outgoing>F25</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Continue" name="Continue"><bpmn:documentation>{&quot;actor&quot;:&quot;Agency funds control&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;}</bpmn:documentation><bpmn:incoming>F21</bpmn:incoming><bpmn:incoming>F25</bpmn:incoming><bpmn:outgoing>F26</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_FinalAccept" name="Agency engineer&#10;Accept remaining&#10;contract work"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency engineer&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;,&quot;notes&quot;:&quot;Later work acceptance, after the current live snapshot.&quot;,&quot;actor&quot;:&quot;Agency engineer&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;,&quot;activity&quot;:&quot;Accept remaining\ncontract work&quot;}</bpmn:documentation><bpmn:incoming>F26</bpmn:incoming><bpmn:outgoing>F27</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_FinalPay" name="Agency finance / Treasury&#10;Pay final $250K&#10;Financial system"><bpmn:documentation>{&quot;owner&quot;:&quot;Agency finance / Treasury&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;,&quot;notes&quot;:&quot;Actual final payment stays in the financial system.&quot;,&quot;actor&quot;:&quot;Agency finance / Treasury&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;,&quot;activity&quot;:&quot;Pay final $250K\nFinancial system&quot;}</bpmn:documentation><bpmn:incoming>F27</bpmn:incoming><bpmn:outgoing>F28</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_FinalReceipt" name="Agency finance / Treasury&#10;T6 · Attest final&#10;payment · $250K"><bpmn:documentation>{&quot;owner&quot;:&quot;Payment attestation&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T6&quot;,&quot;element&quot;:&quot;Task_FinalReceipt&quot;,&quot;name&quot;:&quot;Attest later final payment&quot;,&quot;owner&quot;:&quot;Payment attestation&quot;,&quot;input&quot;:250,&quot;outputs&quot;:[250],&quot;split&quot;:&quot;250 obligated/unpaid → 250 paid&quot;,&quot;notes&quot;:&quot;This is a later event, beyond the live dashboard snapshot. The final payment occurs in the financial system.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;},&quot;actor&quot;:&quot;Agency finance / Treasury&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;,&quot;activity&quot;:&quot;T6 · Attest final\npayment · $250K&quot;}</bpmn:documentation><bpmn:incoming>F28</bpmn:incoming><bpmn:outgoing>F29</bpmn:outgoing></bpmn:userTask>
  <bpmn:userTask id="Task_Reconcile" name="Finance / audit&#10;9 · Reconcile&#10;Retain audit trail"><bpmn:documentation>{&quot;owner&quot;:&quot;Finance / audit&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;,&quot;notes&quot;:&quot;Reconcile the $750K contract. Account closeout follows its own availability rules.&quot;,&quot;actor&quot;:&quot;Finance / audit&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;,&quot;activity&quot;:&quot;9 · Reconcile\nRetain audit trail&quot;}</bpmn:documentation><bpmn:incoming>F29</bpmn:incoming><bpmn:outgoing>F30</bpmn:outgoing></bpmn:userTask>
  <bpmn:exclusiveGateway id="Gateway_Checkpoint" name="Checkpoint?"><bpmn:documentation>{&quot;actor&quot;:&quot;Finance / audit&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;}</bpmn:documentation><bpmn:incoming>F30</bpmn:incoming><bpmn:outgoing>F31</bpmn:outgoing><bpmn:outgoing>F33</bpmn:outgoing></bpmn:exclusiveGateway>
  <bpmn:userTask id="Task_Checkpoint" name="Finance / audit&#10;T7 · Optional&#10;reconciliation receipt"><bpmn:documentation>{&quot;owner&quot;:&quot;Reconciliation approval&quot;,&quot;artifact&quot;:null,&quot;notes&quot;:null,&quot;transaction&quot;:{&quot;id&quot;:&quot;T7&quot;,&quot;element&quot;:&quot;Task_Checkpoint&quot;,&quot;name&quot;:&quot;Reconciliation checkpoint&quot;,&quot;optional&quot;:true,&quot;owner&quot;:&quot;Reconciliation approval&quot;,&quot;input&quot;:750,&quot;outputs&quot;:[750],&quot;split&quot;:&quot;500 paid + 250 paid → 750 reconciled&quot;,&quot;notes&quot;:&quot;Optional checkpoint. Paid markers stay historical; reconciliation does not release fresh budget authority.&quot;,&quot;artifact&quot;:&quot;examples/lifecycle/09-closeout.md&quot;},&quot;actor&quot;:&quot;Finance / audit&quot;,&quot;phase&quot;:&quot;Adjustment, later payment and closeout&quot;,&quot;activity&quot;:&quot;T7 · Optional\nreconciliation receipt&quot;}</bpmn:documentation><bpmn:incoming>F31</bpmn:incoming><bpmn:outgoing>F32</bpmn:outgoing></bpmn:userTask>
